COMPOSE_PROJECT_NAME=spa_staging
SPA_IMAGE=spa-agent:staging-review
SPRING_PROFILES_ACTIVE=staging
HTTP_BIND=127.0.0.1
HTTP_PORT=18088
MYSQL_DATABASE=spa_staging
MYSQL_USER=spa_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generate independent random hex credentials. Do not reuse local credentials.
REDIS_PASSWORD=
SPA_AUTH_ADMIN_USERNAME=admin
SPA_AUTH_ADMIN_PASSWORD_HASH=
SPA_WECHAT_APP_ID=
SPA_WECHAT_APP_SECRET=
DASHSCOPE_API_KEY=local-unconfigured
SPA_DEPLOYMENT_MODE=staging
