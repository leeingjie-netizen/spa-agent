.tab-bar {
  position: fixed;
  right: 20rpx;
  bottom: 18rpx;
  left: 20rpx;
  z-index: 1000;
  display: flex;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 8rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(49, 92, 76, 0.1);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(32, 54, 45, 0.15);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #92968f;
}

.tab-text { margin-top: 8rpx; font-size: 20rpx; font-weight: 500; }
.tab-icon { position: relative; width: 40rpx; height: 40rpx; color: currentColor; }

.icon-home::before {
  position: absolute; top: 12rpx; left: 7rpx; width: 24rpx; height: 22rpx;
  border: 3rpx solid currentColor; border-top: 0; border-radius: 2rpx 2rpx 6rpx 6rpx; content: '';
}

.icon-home::after {
  position: absolute; top: 5rpx; left: 9rpx; width: 20rpx; height: 20rpx;
  border-top: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(45deg); content: '';
}

.grid-dot { position: absolute; width: 13rpx; height: 13rpx; border: 3rpx solid currentColor; border-radius: 4rpx; }
.dot-one { top: 2rpx; left: 2rpx; }
.dot-two { top: 2rpx; right: 2rpx; }
.dot-three { bottom: 2rpx; left: 2rpx; }
.dot-four { right: 2rpx; bottom: 2rpx; }

.icon-orders { border: 3rpx solid currentColor; border-radius: 6rpx; }
.icon-orders::before,
.icon-orders::after { position: absolute; left: 8rpx; width: 20rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; content: ''; }
.icon-orders::before { top: 11rpx; }
.icon-orders::after { top: 23rpx; }

.icon-profile::before {
  position: absolute; top: 1rpx; left: 12rpx; width: 16rpx; height: 16rpx;
  border: 3rpx solid currentColor; border-radius: 50%; content: '';
}

.icon-profile::after {
  position: absolute; right: 4rpx; bottom: 1rpx; left: 4rpx; height: 16rpx;
  border: 3rpx solid currentColor; border-radius: 20rpx 20rpx 8rpx 8rpx; content: '';
}

.is-active { color: #315c4c; }
.is-active .tab-icon { transform: translateY(-2rpx); }
