.booking-page { min-height: 100vh; padding: 28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); }
.booking-summary { display: flex; align-items: center; padding: 24rpx; border-radius: 26rpx; background: #315c4c; color: #fff; }
.summary-art { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-right: 22rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 24rpx; background: rgba(255,255,255,.1); font-family: Georgia, "Songti SC", serif; font-size: 42rpx; }
.summary-copy { flex: 1; min-width: 0; }
.summary-name, .summary-meta { display: block; }
.summary-name { font-size: 28rpx; font-weight: 600; }
.summary-meta { margin-top: 10rpx; color: rgba(255,255,255,.68); font-size: 20rpx; }
.summary-price { margin-left: 15rpx; font-family: Georgia, serif; font-size: 32rpx; }
.booking-section { margin-top: 28rpx; padding: 32rpx 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 36rpx rgba(42,58,51,.05); }
.section-heading { display: flex; align-items: flex-start; }
.step-number { margin-right: 20rpx; color: #aa895b; font-family: Georgia, serif; font-size: 22rpx; letter-spacing: 2rpx; }
.section-title, .section-desc { display: block; }
.section-title { color: #2c3c35; font-size: 29rpx; font-weight: 600; }
.section-desc { margin-top: 8rpx; color: #9a9e9a; font-size: 20rpx; }
.staff-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.staff-option { display: flex; align-items: center; width: 100%; padding: 20rpx; border: 1rpx solid #e5e8e4; border-radius: 22rpx; text-align: left; }
.staff-option.is-selected { border-color: #668374; background: #f0f5f1; }
.staff-avatar { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; margin-right: 20rpx; border-radius: 50%; background: #dce7df; color: #496a5b; font-family: Georgia, serif; font-size: 23rpx; }
.staff-copy { flex: 1; min-width: 0; }
.staff-name, .staff-intro { display: block; }
.staff-name { font-size: 26rpx; font-weight: 600; }
.staff-intro { overflow: hidden; margin-top: 8rpx; color: #8c918d; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.radio { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-left: 15rpx; border: 2rpx solid #c8cfca; border-radius: 50%; }
.is-selected .radio { border-color: #315c4c; }
.radio-dot { width: 18rpx; height: 18rpx; border-radius: 50%; }
.is-selected .radio-dot { background: #315c4c; }
.date-scroll { margin-top: 28rpx; white-space: nowrap; }
.date-row { display: inline-flex; gap: 14rpx; }
.date-option { display: inline-flex; flex-direction: column; align-items: center; width: 112rpx; padding: 18rpx 10rpx; border: 1rpx solid #e1e5e1; border-radius: 20rpx; color: #667069; }
.date-option.is-selected { border-color: #315c4c; background: #315c4c; color: #fff; }
.date-week, .date-value { display: block; }
.date-week { font-size: 21rpx; }
.date-value { margin-top: 10rpx; font-family: Georgia, serif; font-size: 25rpx; }
.slot-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; margin-top: 28rpx; }
.slot-option { padding: 20rpx 8rpx; border: 1rpx solid #dfe4df; border-radius: 18rpx; color: #58655e; font-family: Georgia, sans-serif; font-size: 24rpx; }
.slot-option.is-selected { border-color: #315c4c; background: #315c4c; color: #fff; }
.remark-input { width: 100%; height: 170rpx; margin-top: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #f7f6f1; color: #35443d; font-size: 24rpx; line-height: 1.6; }
.remark-placeholder { color: #adb0ac; }
.remark-count { display: block; margin-top: 10rpx; color: #a2a6a2; font-size: 19rpx; text-align: right; }
.submit-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(49,92,76,.1); background: rgba(255,255,255,.98); }
.submit-price { display: flex; flex: 0 0 190rpx; flex-direction: column; color: #8d6746; font-size: 34rpx; font-weight: 600; }
.submit-label { margin-bottom: 6rpx; color: #979b97; font-size: 19rpx; font-weight: 400; }
.submit-button { flex: 1; height: 88rpx; border-radius: 44rpx; background: #315c4c; color: #fff; font-size: 27rpx; font-weight: 600; }
.submit-button[disabled] { background: #aebbb5; }
