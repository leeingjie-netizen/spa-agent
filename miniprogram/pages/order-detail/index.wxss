.detail-page { min-height: 100vh; padding: 30rpx; }
.status-hero { display: flex; flex-direction: column; padding: 42rpx 36rpx; border-radius: 30rpx; background: #315c4c; color: #fff; }
.status-cancelled { background: #80665e; }
.status-completed { background: #596862; }
.status-label { font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 600; }
.status-desc { margin-top: 12rpx; color: rgba(255,255,255,.7); font-size: 22rpx; }
.detail-card, .payment-card { margin-top: 24rpx; padding: 34rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(42,58,51,.06); }
.card-eyebrow { color: #a48152; font-size: 18rpx; letter-spacing: 4rpx; }
.service-name { display: block; margin: 20rpx 0 30rpx; font-family: Georgia, "Songti SC", serif; font-size: 36rpx; font-weight: 600; }
.info-row { display: flex; justify-content: space-between; margin-top: 22rpx; color: #8b908c; font-size: 23rpx; }
.info-row text:last-child { max-width: 430rpx; color: #34443d; text-align: right; }
.payment-card { display: flex; align-items: center; justify-content: space-between; }
.payment-title, .payment-desc { display: block; }
.payment-title { font-size: 26rpx; font-weight: 600; }
.payment-desc { margin-top: 9rpx; color: #969a96; font-size: 20rpx; }
.pending-badge { padding: 9rpx 16rpx; border-radius: 20rpx; background: #eee8dd; color: #92704a; font-size: 19rpx; }
.detail-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.detail-actions button { flex: 1; }
.cancel-button { display: flex; align-items: center; justify-content: center; height: 96rpx; border: 1rpx solid #a57365; border-radius: 48rpx; color: #955d4d; font-size: 27rpx; font-weight: 600; }
