.detail-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.detail-hero { position: relative; overflow: hidden; height: 520rpx; padding: 52rpx 40rpx; background: linear-gradient(145deg, #668272, #294b3f); color: #fff; }
.hero-orbit { position: absolute; border: 2rpx solid rgba(255,255,255,.18); border-radius: 50%; }
.orbit-one { top: -120rpx; right: -70rpx; width: 400rpx; height: 400rpx; }
.orbit-two { right: 120rpx; bottom: -250rpx; width: 520rpx; height: 520rpx; }
.hero-eyebrow { position: relative; font-size: 19rpx; letter-spacing: 5rpx; opacity: .78; }
.hero-mark { position: absolute; right: 54rpx; bottom: -20rpx; color: rgba(255,255,255,.12); font-family: Georgia, "Songti SC", serif; font-size: 300rpx; }
.hero-duration { position: absolute; bottom: 52rpx; left: 40rpx; display: flex; align-items: baseline; font-family: Georgia, serif; font-size: 74rpx; }
.duration-unit { margin-left: 12rpx; font-family: "PingFang SC", sans-serif; font-size: 22rpx; opacity: .72; }
.detail-content { margin-top: -34rpx; padding: 44rpx 36rpx 70rpx; border-radius: 34rpx 34rpx 0 0; background: #f7f3ea; }
.title-row { display: flex; align-items: flex-start; justify-content: space-between; }
.title-copy { flex: 1; min-width: 0; }
.service-name, .service-tagline { display: block; }
.service-name { font-family: Georgia, "Songti SC", serif; font-size: 46rpx; font-weight: 600; }
.service-tagline { margin-top: 12rpx; color: #8c918c; font-size: 22rpx; letter-spacing: 2rpx; }
.service-price { margin-left: 24rpx; color: #926c47; font-size: 42rpx; font-weight: 600; }
.currency { margin-right: 3rpx; font-size: 22rpx; }
.divider { height: 1rpx; margin: 40rpx 0; background: rgba(49,92,76,.12); }
.content-section { margin-top: 52rpx; }
.section-eyebrow, .section-title, .description { display: block; }
.section-eyebrow { color: #a68356; font-size: 18rpx; letter-spacing: 4rpx; }
.section-title { margin-top: 10rpx; font-family: Georgia, "Songti SC", serif; font-size: 34rpx; font-weight: 600; }
.description { margin-top: 22rpx; color: #6f7772; font-size: 26rpx; line-height: 1.85; }
.benefit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 44rpx; }
.benefit-item { display: flex; flex-direction: column; min-height: 220rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }
.benefit-index { color: #aa895b; font-family: Georgia, serif; font-size: 20rpx; }
.benefit-title { margin-top: 28rpx; font-size: 27rpx; font-weight: 600; }
.benefit-desc { margin-top: 12rpx; color: #8c918c; font-size: 21rpx; line-height: 1.6; }
.notice-section { padding: 34rpx; border-radius: 28rpx; background: #ebe5d9; }
.notice-item { display: flex; align-items: flex-start; margin-top: 22rpx; color: #68706b; font-size: 23rpx; line-height: 1.65; }
.notice-dot { flex: 0 0 8rpx; height: 8rpx; margin: 14rpx 18rpx 0 0; border-radius: 50%; background: #8ca294; }
.ai-helper { display: flex; align-items: center; width: 100%; margin-top: 28rpx; padding: 26rpx; border: 1rpx solid rgba(49,92,76,.13); border-radius: 24rpx; background: #fff; text-align: left; }
.ai-badge { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-right: 20rpx; border-radius: 50%; background: #315c4c; color: #fff; font-family: Georgia, serif; }
.ai-title, .ai-desc { display: block; }
.ai-title { font-size: 25rpx; font-weight: 600; }
.ai-desc { margin-top: 8rpx; color: #969a96; font-size: 20rpx; }
.ai-arrow { margin-left: auto; color: #789084; font-size: 42rpx; }
.booking-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(49,92,76,.1); background: rgba(255,255,255,.97); }
.booking-price { display: flex; flex: 0 0 185rpx; flex-direction: column; color: #8f6744; font-size: 34rpx; font-weight: 600; }
.price-label { margin-bottom: 5rpx; color: #92968f; font-size: 19rpx; font-weight: 400; }
.book-now { flex: 1; height: 88rpx; border-radius: 44rpx; background: #315c4c; color: #fff; font-size: 27rpx; font-weight: 600; }
