<view class="review-page"><text class="eyebrow">A NOTE FROM YOU</text><text class="review-title">这次护理，感受如何？</text><text class="review-subtitle">你的真实体验，帮助我们把每一处细节做得更好。</text><status-view wx:if="{{done}}" title="感谢你的分享" description="评价已保存，期待下一次为你留出放松时光" actionText="返回订单" bind:action="back"></status-view><block wx:else><view class="review-form"><text class="review-label">整体体验</text><view class="stars"><button wx:for="{{stars}}" wx:key="*this" class="star {{rating >= item ? 'selected' : ''}}" data-rating="{{item}}" bindtap="selectRating">★</button></view><text class="review-label">说说你的感受</text><textarea maxlength="1000" class="review-input" value="{{comment}}" bindinput="input" placeholder="服务、环境或你希望改进的地方（选填）"></textarea><text class="review-count">{{comment.length}} / 1000</text></view><text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text><button class="primary-button" bindtap="submit" loading="{{sending}}" disabled="{{sending}}">提交真实评价</button></block></view>
