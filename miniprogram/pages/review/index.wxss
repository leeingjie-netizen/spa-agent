.review-page {padding:56rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));}.review-title {display:block;margin:24rpx 0 18rpx;font-size:42rpx;color:#315c4c;font-weight:600;}.review-subtitle {display:block;font-size:25rpx;line-height:1.8;color:#818777;}.review-form {margin:40rpx 0;padding:30rpx;background:#fff;border:1rpx solid #e2e7dc;border-radius:28rpx;}.review-label {display:block;color:#4e6052;font-size:26rpx;}.stars {display:flex;gap:20rpx;margin:24rpx 0 40rpx;}.star {color:#dbded2;font-size:54rpx;}.star.selected {color:#a48152;}.review-input {width:100%;min-height:220rpx;margin-top:20rpx;padding:20rpx;border-radius:18rpx;background:#f6f6f0;font-size:25rpx;line-height:1.7;}.review-count {display:block;margin-top:14rpx;color:#959b8d;text-align:right;font-size:22rpx;}
