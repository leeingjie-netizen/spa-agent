.services-page { padding-top: 38rpx; }
.service-hero { display: flex; flex-direction: column; }
.hero-eyebrow { color: #a48152; font-size: 19rpx; letter-spacing: 5rpx; }
.hero-title { margin-top: 14rpx; font-family: Georgia, "Songti SC", serif; font-size: 48rpx; font-weight: 600; }
.hero-subtitle { margin-top: 14rpx; color: #858b86; font-size: 22rpx; }
.search-wrap { margin-top: 34rpx; }
.search-box { display: flex; align-items: center; height: 88rpx; padding: 0 26rpx; border: 1rpx solid rgba(49,92,76,.1); border-radius: 44rpx; background: rgba(255,255,255,.82); }
.search-icon { width: 25rpx; height: 25rpx; margin-right: 18rpx; border: 3rpx solid #72827a; border-radius: 50%; }
.search-icon::after { display: block; width: 13rpx; height: 3rpx; margin: 20rpx 0 0 18rpx; border-radius: 2rpx; background: #72827a; transform: rotate(45deg); content: ''; }
.search-input { flex: 1; height: 80rpx; color: #273731; font-size: 25rpx; }
.search-placeholder { color: #afb2ae; }
.clear-button { width: 50rpx; color: #8d948f; font-size: 34rpx; }
.category-scroll { margin-top: 26rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 16rpx; padding: 0 32rpx 8rpx; }
.category-chip { padding: 18rpx 30rpx; border: 1rpx solid #d9ded9; border-radius: 36rpx; background: rgba(255,255,255,.55); color: #757c77; font-size: 23rpx; }
.category-chip.is-active { border-color: #315c4c; background: #315c4c; color: #fff; }
.service-count { display: flex; justify-content: space-between; margin-top: 34rpx; color: #384941; font-size: 23rpx; }
.count-note { color: #9a9e9a; font-size: 20rpx; }
.service-grid { display: flex; flex-wrap: wrap; gap: 22rpx; margin-top: 22rpx; }
.service-cell { width: calc(50% - 11rpx); }
