.profile-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.profile-header { padding: 38rpx 32rpx 0; background: #e9e4d8; }
.header-eyebrow { color: #99784d; font-size: 18rpx; letter-spacing: 5rpx; }
.user-row { display: flex; align-items: center; margin-top: 28rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; margin-right: 22rpx; border: 2rpx solid rgba(49,92,76,.15); border-radius: 50%; background: #f8f4eb; color: #547061; font-family: Georgia, "Songti SC", serif; font-size: 40rpx; }
.user-copy { flex: 1; }
.user-name, .user-note { display: block; }
.user-name { font-size: 32rpx; font-weight: 600; }
.user-note { margin-top: 9rpx; color: #85867f; font-size: 20rpx; }
.settings-button { padding: 20rpx; color: #68776f; font-size: 32rpx; letter-spacing: 4rpx; }
.member-card { position: relative; overflow: hidden; height: 330rpx; margin-top: 34rpx; padding: 38rpx; border-radius: 34rpx 34rpx 0 0; background: linear-gradient(135deg, #365d4e, #1f3c32); color: #fff; }
.card-orbit { position: absolute; border: 1rpx solid rgba(255,255,255,.16); border-radius: 50%; }
.orbit-one { top: -100rpx; right: -70rpx; width: 330rpx; height: 330rpx; }
.orbit-two { right: 100rpx; bottom: -230rpx; width: 430rpx; height: 430rpx; }
.member-eyebrow, .member-title, .member-status, .member-number { position: relative; display: block; }
.member-eyebrow { font-size: 18rpx; letter-spacing: 5rpx; opacity: .72; }
.member-title { margin-top: 34rpx; font-family: Georgia, "Songti SC", serif; font-size: 40rpx; }
.member-status { margin-top: 16rpx; color: rgba(255,255,255,.68); font-size: 21rpx; }
.member-number { margin-top: 54rpx; font-family: Georgia, serif; font-size: 18rpx; letter-spacing: 3rpx; opacity: .62; }
.asset-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 32rpx; padding: 26rpx 0; border-radius: 0 0 28rpx 28rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(42,58,51,.06); }
.asset-item { display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid #eceeeb; }
.asset-item:last-child { border-right: 0; }
.asset-value { color: #43564d; font-size: 24rpx; font-weight: 600; }
.asset-label { margin-top: 9rpx; color: #949994; font-size: 20rpx; }
.appointment-entry { display: flex; align-items: center; margin: 28rpx 32rpx 0; padding: 30rpx; border-radius: 28rpx; background: #315c4c; color: #fff; }
.entry-icon { position: relative; width: 66rpx; height: 66rpx; margin-right: 22rpx; border: 2rpx solid rgba(255,255,255,.55); border-radius: 18rpx; }
.calendar-line { height: 2rpx; margin-top: 18rpx; background: rgba(255,255,255,.55); }
.entry-copy { flex: 1; }
.entry-title, .entry-desc { display: block; }
.entry-title { font-size: 27rpx; font-weight: 600; }
.entry-desc { margin-top: 8rpx; color: rgba(255,255,255,.65); font-size: 20rpx; }
.entry-arrow, .row-arrow { font-size: 40rpx; }
.service-panel { margin: 28rpx 32rpx 0; padding: 32rpx; border-radius: 28rpx; background: #fff; }
.panel-title { display: block; margin-bottom: 10rpx; font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 600; }
.service-row { display: flex; align-items: center; width: 100%; padding: 24rpx 0; border-bottom: 1rpx solid #eef0ee; text-align: left; }
.service-row:last-child { border-bottom: 0; }
.service-dot { width: 18rpx; height: 18rpx; margin-right: 22rpx; border-radius: 50%; background: #789385; }
.dot-1 { background: #b5966c; }
.dot-2 { background: #83939a; }
.service-copy { flex: 1; }
.service-title, .service-desc { display: block; }
.service-title { color: #35453e; font-size: 25rpx; }
.service-desc { margin-top: 8rpx; color: #a0a39f; font-size: 19rpx; }
.pending-tag { margin-right: 14rpx; padding: 6rpx 12rpx; border-radius: 16rpx; background: #f0ebe1; color: #9a7953; font-size: 17rpx; }
.row-arrow { color: #a5aaa6; }
.profile-note { display: flex; flex-direction: column; align-items: center; padding: 50rpx 30rpx; color: #9ca09c; font-size: 19rpx; line-height: 1.8; }
