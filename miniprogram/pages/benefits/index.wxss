.benefits-page {padding:40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));}.benefits-title {display:block;margin-top:20rpx;font-size:40rpx;font-weight:600;color:#315c4c;}.benefits-tabs {display:flex;gap:8rpx;padding:8rpx;margin:36rpx 0;border-radius:24rpx;background:#e9ecdf;}.benefits-tab {flex:1;padding:20rpx 0;border-radius:18rpx;font-size:26rpx;color:#788170;}.benefits-tab.active {background:#fff;color:#315c4c;font-weight:600;}.membership-card {padding:40rpx;border-radius:28rpx;background:#315c4c;color:#f7f3ea;}.membership-brand {font-size:21rpx;letter-spacing:4rpx;color:#d0d6bc;}.membership-tier {display:block;margin:32rpx 0 20rpx;font-size:48rpx;}.membership-subtitle {font-size:24rpx;color:#ccd9cc;}.membership-points {display:flex;flex-direction:column;gap:8rpx;margin-top:44rpx;}.membership-points text:first-child {font:52rpx Georgia,serif;}.membership-points text:last-child {font-size:22rpx;color:#ccd9cc;}.benefits-note {margin:28rpx 0;font-size:24rpx;line-height:1.9;color:#7d8776;}.section-title {display:block;margin:36rpx 0 22rpx;font-size:29rpx;font-weight:600;}.coupon-ticket {display:flex;margin-bottom:22rpx;border:1rpx solid #dce4d4;border-radius:24rpx;background:#fff;overflow:hidden;}.coupon-amount {display:flex;flex-direction:column;justify-content:center;gap:12rpx;flex-shrink:0;width:210rpx;padding:28rpx 18rpx;text-align:center;background:#e6ecdf;border-right:2rpx dashed #c9d4bc;}.coupon-amount text:first-child {font-size:40rpx;color:#315c4c;font-weight:600;}.coupon-amount text:last-child {font-size:21rpx;color:#708265;}.coupon-copy {flex:1;min-width:0;padding:24rpx;}.coupon-copy>text {display:block;line-height:1.6;}.coupon-copy>text:first-child {font-size:27rpx;font-weight:600;}.coupon-copy>text:nth-child(2) {font-size:21rpx;color:#919786;margin-top:10rpx;}.coupon-status {font-size:23rpx;color:#9a7a51;margin-top:10rpx;}.claim-button {display:inline-block;margin-top:18rpx;padding:10rpx 24rpx;border-radius:22rpx;background:#315c4c;color:#fff;font-size:22rpx;}.claim-button[disabled] {opacity:.4;}.coupon-inactive {opacity:.65;}.wallet-warning {padding:20rpx 24rpx;border-radius:18rpx;background:#ede1c8;color:#8c6745;font-size:24rpx;}.wallet-balance {padding:36rpx 0;}.wallet-balance text {display:block;}.wallet-balance text:first-child {font-size:26rpx;color:#75836c;}.wallet-balance text:nth-child(2) {margin:20rpx 0;font:64rpx Georgia,serif;color:#315c4c;}.wallet-balance text:last-child {font-size:22rpx;color:#9a8974;}.wallet-form {padding:28rpx;border-radius:24rpx;background:#fff;}.wallet-form .section-title {margin:0 0 20rpx;}.wallet-form input {height:88rpx;min-height:88rpx;padding:0 16rpx;border-bottom:1rpx solid #e3e7d9;margin-bottom:28rpx;font-size:28rpx;}.wallet-entry {display:flex;justify-content:space-between;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #dce3d3;}.wallet-entry view:last-child {text-align:right;}.wallet-entry text {display:block;font-size:26rpx;}.wallet-entry text+text {margin-top:10rpx;font-size:21rpx;color:#8a9382;}
.wallet-card {margin:12rpx 0 30rpx;padding:40rpx;border-radius:28rpx;background:#e6ecdf;}.development-entry {width:100%;margin:32rpx 0;color:#8b7d66;font-size:23rpx;padding:22rpx;}
