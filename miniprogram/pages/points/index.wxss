.points-page {padding:40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));}.points-hero {padding:40rpx;border-radius:28rpx;background:#e4e9dd;}.points-title {display:block;margin-top:24rpx;font-size:34rpx;font-weight:600;color:#315c4c;}.points-number {display:block;margin-top:32rpx;font:80rpx Georgia,serif;color:#315c4c;}.points-caption {display:block;margin-top:12rpx;font-size:22rpx;color:#75816f;}.ledger {margin-top:40rpx;}.ledger-title {font-size:30rpx;font-weight:600;}.ledger-row {display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #dce2d5;}.ledger-reason,.ledger-time {display:block;}.ledger-reason {font-size:26rpx;}.ledger-time {margin-top:10rpx;color:#87907e;font-size:22rpx;}.ledger-amount {color:#315c4c;font-size:32rpx;}.points-note {display:block;margin-top:40rpx;color:#8d9388;font-size:22rpx;line-height:1.8;}
