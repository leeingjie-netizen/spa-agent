# Local development only. Copy to .env.local and set your own values.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=18080
SPA_AUTH_ADMIN_USERNAME=admin
# At least 12 characters; generated local credentials are never committed.
SPA_AUTH_ADMIN_PASSWORD=
SPA_AUTH_DEV_LOGIN_ENABLED=true
SPA_PAYMENT_MOCK_ENABLED=true
# application.yml reads ${DASHSCOPE_API_KEY}; IDEA inherits its launch environment.
# run-local.ps1 preserves an inherited key, or reads this value from ignored .env.local.
# Quotes around a value are supported. Never commit it or paste it into logs.
# Check presence without calling a model: ./scripts/run-local.ps1 -CheckAiConfiguration
DASHSCOPE_API_KEY=
# Existing ignored application.yml supplies MySQL/Redis. Optional overrides:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/spa?serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATA_REDIS_HOST=192.168.100.128
# SPA_WECHAT_APP_ID=
# SPA_WECHAT_APP_SECRET=
